# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Paystack API Keys (Get these from your Paystack Dashboard: https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Currency & Settlement Settings
# DEFAULT_BASE_CURRENCY: The reference currency your products/prices are priced in (e.g., USD, NGN, EUR)
DEFAULT_BASE_CURRENCY=USD

# MERCHANT_SETTLEMENT_CURRENCY: The actual currency your Paystack merchant account receives payouts in (NGN, USD, GHS, ZAR, KES).
# If you are in Nigeria with a standard NGN account, keep this as NGN.
# The checkout will show foreign users their local price (e.g. $10 USD or ¥72 CNY) and convert seamlessly to NGN for Paystack processing.
MERCHANT_SETTLEMENT_CURRENCY=NGN

# Currency Conversion Margin (Percentage buffer to protect against rapid intraday FX fluctuations, e.g. 1.5%)
FX_BUFFER_PERCENT=1.5

# Branding
MERCHANT_NAME="Acme Pro Apps"
MERCHANT_LOGO_URL="/images/logo.png"
MERCHANT_SUPPORT_EMAIL="support@example.com"
